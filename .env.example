# Hostinger MySQL connection string
DATABASE_URL=mysql://myappuser:mypassword@127.0.0.1:3306/myapp

# Optional MySQL pool limit
DB_CONNECTION_LIMIT=10

# Set this to the email address that should receive the admin role on first signup.
ADMIN_EMAIL=admin@example.com

# Optional Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools verification token
BING_SITE_VERIFICATION=
