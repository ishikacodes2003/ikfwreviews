# Hostinger MySQL connection string
DATABASE_URL=mysql://myappuser:mypassword@127.0.0.1:3306/myapp

# Optional MySQL pool limit
DB_CONNECTION_LIMIT=10

# Admin authentication credentials
# When set, the administrator can log in directly at /login using these credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-admin-password
# Optional admin username (defaults to "admin" or username part of ADMIN_EMAIL)
ADMIN_USERNAME=admin

# Optional Google Search Console HTML meta verification token
GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools verification token
BING_SITE_VERIFICATION=
